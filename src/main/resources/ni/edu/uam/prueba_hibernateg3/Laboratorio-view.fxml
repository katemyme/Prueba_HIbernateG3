<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="640.0" prefWidth="900.0" spacing="12.0"
      style="-fx-font-family: 'Times New Roman'; -fx-font-size: 14px;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.prueba_hibernateg3.Controller.EquipoController">
    <children>
        <Label text="Control de Equipos de Laboratorio">
            <font>
                <Font name="Times New Roman Bold" size="22.0" />
            </font>
        </Label>

        <!-- Formulario -->
        <GridPane hgap="10.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="70.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints hgrow="NEVER" minWidth="70.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
            <children>
                <Label text="ID:" />
                <TextField fx:id="txtId" editable="false" focusTraversable="false" promptText="Generado automáticamente" GridPane.columnIndex="1" />

                <Label text="Código:" GridPane.rowIndex="1" />
                <TextField fx:id="txtCodigo" promptText="Ej. LAP-001" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Nombre:" GridPane.rowIndex="2" />
                <TextField fx:id="txtNombre" promptText="Nombre del equipo" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Marca:" GridPane.rowIndex="3" />
                <TextField fx:id="txtMarca" promptText="Marca (opcional)" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Cantidad:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <TextField fx:id="txtCantidad" promptText="Entero mayor o igual a 0" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                <Label text="Tipo:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <ComboBox fx:id="cmbTipo" maxWidth="1.7976931348623157E308" promptText="Seleccione un tipo" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                <Label text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" promptText="Seleccione un estado" GridPane.columnIndex="3" GridPane.rowIndex="3" />
            </children>
        </GridPane>

        <!-- Botones CRUD -->
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarEquipo" text="Guardar" />
                <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarEquipo" text="Actualizar" />
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarEquipo" text="Eliminar" />
                <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarCampos" text="Limpiar" />
            </children>
        </HBox>

        <Separator />

        <!-- Búsqueda y filtros (se pueden combinar) -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Buscar nombre:" />
                <TextField fx:id="txtBuscarNombre" onAction="#aplicarFiltros" promptText="Fragmento del nombre" HBox.hgrow="ALWAYS" />
                <Label text="Tipo:" />
                <ComboBox fx:id="cmbFiltroTipo" prefWidth="200.0" promptText="Todos los tipos" />
                <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#aplicarFiltros" text="Buscar / Aplicar filtros" />
                <Button fx:id="btnQuitarFiltros" mnemonicParsing="false" onAction="#quitarFiltros" text="Quitar filtros" />
            </children>
        </HBox>

        <TableView fx:id="tblEquipos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
                <TableColumn fx:id="colMarca" prefWidth="120.0" text="Marca" />
                <TableColumn fx:id="colEstado" prefWidth="140.0" text="Estado" />
                <TableColumn fx:id="colCantidad" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Cantidad" />
                <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
                <Label text="No hay equipos para mostrar." />
            </placeholder>
        </TableView>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</VBox>
